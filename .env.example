# Copy to .env. Ports follow the local block scheme (JLPT = 4220–4229, see docs/local-backend-mcp.md "Ports").
JLPT_WEB_PORT=4220
JLPT_API_PORT=4221
# Loopback only by default. Set 0.0.0.0 only when a phone/LAN device must reach the app directly.
# JLPT_HOST=127.0.0.1
# OAuth/MCP token audience. Leave unset to derive it from each request (127.0.0.1:4220 locally,
# https://jlpt-local.erzhiqian.cc through the tunnel); set it only to pin a single public origin.
# JLPT_PUBLIC_ORIGIN=https://jlpt-local.erzhiqian.cc

# Optional public GA4 measurement ID. Leave unset to disable Google Analytics.
# Production value is managed in wrangler.jsonc.
# VITE_GOOGLE_ANALYTICS_ID=G-M9XM6EXYED

# Encrypts each user's own pronunciation-provider API keys at rest (server/tts/).
# Optional locally: a key is auto-generated into .local/tts-secret.key on first use.
# Cloudflare has no local file storage, so set this there with `wrangler secret put TTS_SECRETS_KEY`.
# JLPT_TTS_SECRETS_KEY=
