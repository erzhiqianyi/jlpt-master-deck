# Copy to .env. Ports follow the local block scheme (JLPT = 4220–4229, see docs/local-backend-mcp.md "Ports").
JLPT_WEB_PORT=4220
JLPT_API_PORT=4221
# Loopback only by default. Set 0.0.0.0 only when a phone/LAN device must reach the app directly.
# JLPT_HOST=127.0.0.1
# OAuth/MCP token audience. Leave unset to derive it from each request (127.0.0.1:4220 locally,
# https://jlpt-local.erzhiqian.cc through the tunnel); set it only to pin a single public origin.
# JLPT_PUBLIC_ORIGIN=https://jlpt-local.erzhiqian.cc
