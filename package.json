{
  "name": "jlpt-master-deck",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:app": "vite --host 0.0.0.0 --port 5193 --strictPort",
    "backend": "node server/api.mjs",
    "mcp": "node server/mcp-server.mjs",
    "mcp:setup": "node scripts/setup-project-mcp.mjs",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0 --port 5193 --strictPort",
    "tunnel": "cloudflared tunnel --config ~/.cloudflared/config.yml run satori-local",
    "dev:tunnel": "bash scripts/dev-with-tunnel.sh",
    "data:blank": "node scripts/create-blank-data.mjs",
    "plan:migrate-prototype": "node scripts/migrate-prototype-study-plan.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
